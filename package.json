{
  "name": "lang-taylor-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run images && astro dev --host 0.0.0.0",
    "images": "node scripts/prepare-images.mjs",
