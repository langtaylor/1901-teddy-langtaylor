    "preview": "astro preview --host 0.0.0.0",
    "video:prepare": "node scripts/prepare-hero-video.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "sharp": "$sharp",
    "unifont": "0.7.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
